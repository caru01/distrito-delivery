# En local use "auto" para apuntar al puerto 3001 de la misma IP que abrió la PWA.
VITE_API_URL=auto
VITE_API_PORT=3001

# En el monorepo estos valores se leen de ../distrito-web/.env como fuente única.
# En CI pueden inyectarse como variables de proceso. No versionar valores reales.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
