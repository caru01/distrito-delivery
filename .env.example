# Las URLs de API por ambiente viven en config/api-environments.json.
# Producción está bloqueada a https://api.distritobg.app y no acepta overrides .env.

# En el monorepo estos valores se leen de ../distrito-web/.env como fuente única.
# En CI pueden inyectarse como variables de proceso. No versionar valores reales.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
